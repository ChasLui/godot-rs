[configuration]

entry_symbol = "editor_plugin_init"
compatibility_minimum = 4.7

[libraries]

macos.debug = "res://lib/libeditor_plugin.dylib"
macos.release = "res://lib/libeditor_plugin.dylib"
linux.debug.x86_64 = "res://lib/libeditor_plugin.so"
linux.release.x86_64 = "res://lib/libeditor_plugin.so"
windows.debug.x86_64 = "res://lib/editor_plugin.dll"
windows.release.x86_64 = "res://lib/editor_plugin.dll"
