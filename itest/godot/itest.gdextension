[configuration]

entry_symbol = "itest_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]

macos.debug = "res://lib/libitest.dylib"
macos.release = "res://lib/libitest.dylib"
linux.debug.x86_64 = "res://lib/libitest.so"
linux.release.x86_64 = "res://lib/libitest.so"
windows.debug.x86_64 = "res://lib/itest.dll"
windows.release.x86_64 = "res://lib/itest.dll"
