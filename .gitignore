# IDEs
.vscode
.idea

# Build and package artifacts
target
*/target
*.rlib

# Godot's per-project cache and import data; regenerated on first open.
.godot/
**/.import/*
/logs

# Compiled extensions copied into the Godot projects. The directories themselves are kept.
**/godot/lib/*
!**/godot/lib/.gitkeep

# OS-specific
.DS_Store

# User stuff
/ignore
